# Copy this file to .env.local and enter the SMTP details provided by your Zimbra administrator.
ZIMBRA_SMTP_HOST=smtp.your-domain.com
ZIMBRA_SMTP_PORT=587
ZIMBRA_EMAIL=website@your-domain.com
ZIMBRA_PASSWORD=replace-with-mailbox-password

# Where website inquiries should be delivered; defaults to ZIMBRA_EMAIL.
CONTACT_EMAIL_TO=website@your-domain.com
